<UserControl x:Class="ThreatPilot.Frontend.Views.IncidentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ThreatPilot.Frontend.Resources"
             FontFamily="{StaticResource PrimaryFont}">

    <UserControl.Resources>
        <res:SeverityToBgConverter x:Key="SevBg" />
        <res:SeverityToFgConverter x:Key="SevFg" />
        <res:StatusToBgConverter x:Key="StatusBg" />
        <res:StatusToFgConverter x:Key="StatusFg" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="36,28,36,36">

            <!-- Back Button -->
            <Button Content="← Back to Alerts" Style="{StaticResource FilterChip}" HorizontalAlignment="Left" Margin="0,0,0,20"
                    Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="Alerts" />

            <!-- Incident Header -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RuleName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{Binding Severity, Converter={StaticResource SevBg}}" CornerRadius="10" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Severity}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource SevFg}}" />
                            </Border>
                            <Border Background="{Binding Status, Converter={StaticResource StatusBg}}" CornerRadius="10" Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusFg}}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22" />

                    <!-- Meta Info -->
                    <Border Background="#F8F9FA" CornerRadius="10" Padding="18,14" Margin="0,18,0,0">
                        <UniformGrid Columns="4">
                            <StackPanel>
                                <TextBlock Text="ALERT ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding AlertId}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentGoldBrush}" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SOURCE IP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SourceIp}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="USER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding UserId}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TIMESTAMP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding Timestamp}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- AI Analysis Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- AI Executive Summary -->
                <Border Style="{StaticResource PremiumCard}" Grid.Column="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="🧠" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="AI Executive Summary" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Border Background="#FFFBF5" CornerRadius="10" Padding="18">
                            <TextBlock Text="{Binding AiSummary}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="24" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,8">
                            <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Severity Analysis" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Border Background="#FFFBF5" CornerRadius="10" Padding="18">
                            <TextBlock Text="{Binding AiSeverityReason}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="24" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Recommended Actions -->
                <Border Style="{StaticResource PremiumCard}" Grid.Column="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="🔧" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Recommended Actions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding RecommendedActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8F9FA" CornerRadius="10" Padding="16,14" Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource AccentGoldBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock Text="→" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="21" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
