<UserControl x:Class="ThreatPilot.Frontend.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ThreatPilot.Frontend.Resources"
             FontFamily="{StaticResource PrimaryFont}">

    <UserControl.Resources>
        <res:SeverityToBgConverter x:Key="SevBg" />
        <res:SeverityToFgConverter x:Key="SevFg" />
        <res:StatusToBgConverter x:Key="StatusBg" />
        <res:StatusToFgConverter x:Key="StatusFg" />
        <res:TimeAgoConverter x:Key="TimeAgo" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="36,28,36,36">

        <!-- Page Header -->
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Threat Center" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Monitor, investigate, and respond to security alerts" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Border Style="{StaticResource PremiumCard}" Padding="16" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Width="320" HorizontalAlignment="Left">
                    <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Panel.ZIndex="1" />
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="36,10,16,10" Tag="Search alerts, IPs, rules..." />
                </Grid>

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="All" Style="{StaticResource FilterChip}" Margin="0,0,8,0" Command="{Binding SetFilterCommand}" CommandParameter="All" />
                    <Button Content="CRITICAL" Style="{StaticResource FilterChip}" Margin="0,0,8,0" Command="{Binding SetFilterCommand}" CommandParameter="CRITICAL" />
                    <Button Content="HIGH" Style="{StaticResource FilterChip}" Margin="0,0,8,0" Command="{Binding SetFilterCommand}" CommandParameter="HIGH" />
                    <Button Content="MEDIUM" Style="{StaticResource FilterChip}" Margin="0,0,8,0" Command="{Binding SetFilterCommand}" CommandParameter="MEDIUM" />
                    <Button Content="LOW" Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="LOW" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Alert List -->
        <ItemsControl ItemsSource="{Binding FilteredAlerts}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,12" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.ViewIncidentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Severity Indicator Bar -->
                            <Border Width="4" CornerRadius="2" Margin="0,0,18,0"
                                    Background="{Binding Severity, Converter={StaticResource SevFg}}" />

                            <!-- Alert Content -->
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RuleName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Background="{Binding Severity, Converter={StaticResource SevBg}}" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Severity}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource SevFg}}" />
                                        </Border>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBg}}" CornerRadius="10" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusFg}}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}">
                                        <Run Text="ID: " /><Run Text="{Binding AlertId}" Foreground="{DynamicResource AccentGoldBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="  •  " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}">
                                        <Run Text="Source: " /><Run Text="{Binding SourceIp}" Foreground="{DynamicResource AccentGoldBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="  •  " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="User: " /><Run Text="{Binding UserId}" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <!-- Time -->
                            <TextBlock Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource TimeAgo}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="16,2,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ScrollViewer>
</UserControl>
