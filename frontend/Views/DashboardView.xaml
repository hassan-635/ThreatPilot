<UserControl x:Class="ThreatPilot.Frontend.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:ThreatPilot.Frontend.Resources"
             FontFamily="{StaticResource PrimaryFont}">

    <UserControl.Resources>
        <res:SeverityToBgConverter x:Key="SevBg" />
        <res:SeverityToFgConverter x:Key="SevFg" />
        <res:TimeAgoConverter x:Key="TimeAgo" />
        
        <Style x:Key="ProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
        <StackPanel Margin="36,28,36,36" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- Page Header -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Real-time security overview of your infrastructure" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0" Effect="{StaticResource SubtleShadow}">
                        <TextBlock Text="{Binding CurrentDateTime}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" Style="{StaticResource PremiumButton}" Padding="16,8" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- System Status Banner -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F0FDF4" CornerRadius="12" Padding="14" VerticalAlignment="Center">
                        <TextBlock Text="🛡" FontSize="26" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Emoji"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="System Status: " />
                            <Run Text="{Binding SystemStatus}" Foreground="#16A34A" />
                        </TextBlock>
                        <TextBlock Text="{Binding LastScanTime, StringFormat='Last scan completed: {0}'}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    
                    <!-- Quick Stats inside Banner -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Alerts Today" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalAlertsToday}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Resolved" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ResolvedToday}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Resolution Rate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ResolutionRate, StringFormat='{}{0}%'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentGoldBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Metric Cards Grid -->
            <ItemsControl ItemsSource="{Binding Metrics}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,16,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Left" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI Emoji"/>
                                    <Border Background="{Binding IsPositive, Converter={StaticResource SevBg}, ConverterParameter='trend'}" 
                                            CornerRadius="12" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Trend}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Value}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,4" />
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Three Column Layout: Threat Dist, Health, Critical Alerts -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- Threat Distribution -->
                <Border Style="{StaticResource PremiumCard}" Grid.Column="0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Threat Distribution" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />
                        <ItemsControl ItemsSource="{Binding ThreatDistribution}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Category}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0}%'}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGoldBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Grid.Row="1" Value="{Binding Percentage}" Maximum="100" Style="{StaticResource ProgressBar}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- System Health -->
                <Border Style="{StaticResource PremiumCard}" Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="System Health" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />
                        <ItemsControl ItemsSource="{Binding SystemHealth}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Dot indicator -->
                                        <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#16A34A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="YELLOW">
                                                            <Setter Property="Fill" Value="#D97706" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusColor}" Value="RED">
                                                            <Setter Property="Fill" Value="#DC2626" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Uptime}" FontSize="11" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Critical Alerts Panel -->
                <Border Style="{StaticResource PremiumCard}" Grid.Column="4" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock Text="Critical Alerts" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{StaticResource SeverityCriticalBg}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding CriticalAlerts.Count, StringFormat='{}{0} active'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SeverityCriticalFg}" />
                            </Border>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CriticalAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClickableCard}" Background="#FFFBF5" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding RuleName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border Background="{Binding Severity, Converter={StaticResource SevBg}}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Severity}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding Severity, Converter={StaticResource SevFg}}" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" FontFamily="{StaticResource MonoFont}">
                                                <Run Text="Source: " />
                                                <Run Text="{Binding SourceIp}" FontWeight="Bold" Foreground="{DynamicResource AccentGoldBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity Panel -->
            <Border Style="{StaticResource PremiumCard}" MaxWidth="1300">
                <StackPanel>
                    <TextBlock Text="Recent Activity Stream" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16" Margin="0,0,0,8" CornerRadius="10" Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity Dot -->
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,5,16,0"
                                                 Fill="{Binding Severity, Converter={StaticResource SevFg}}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding EventType}" />
                                                <Run Text=" — " Foreground="{DynamicResource TextMutedBrush}" FontWeight="Normal"/>
                                                <Run Text="{Binding SourceIp}" Foreground="{DynamicResource AccentGoldBrush}" FontFamily="{StaticResource MonoFont}" FontSize="13" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource TimeAgo}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="16,2,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
