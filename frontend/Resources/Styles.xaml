<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========= PREMIUM FONTS ========= -->
    <FontFamily x:Key="PrimaryFont">Segoe UI Variable, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- ========= SEVERITY BADGE COLORS ========= -->
    <SolidColorBrush x:Key="SeverityCriticalBg" Color="#FEE2E2" />
    <SolidColorBrush x:Key="SeverityCriticalFg" Color="#DC2626" />
    <SolidColorBrush x:Key="SeverityHighBg" Color="#FFF7ED" />
    <SolidColorBrush x:Key="SeverityHighFg" Color="#EA580C" />
    <SolidColorBrush x:Key="SeverityMediumBg" Color="#FFFBEB" />
    <SolidColorBrush x:Key="SeverityMediumFg" Color="#D97706" />
    <SolidColorBrush x:Key="SeverityLowBg" Color="#F0FDF4" />
    <SolidColorBrush x:Key="SeverityLowFg" Color="#16A34A" />

    <!-- ========= PREMIUM CARD WITH HOVER ========= -->
    <Style x:Key="PremiumCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{StaticResource PremiumShadow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource HoverShadow}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderMediumBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Clickable card with cursor change -->
    <Style x:Key="ClickableCard" TargetType="Border" BasedOn="{StaticResource PremiumCard}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource DeepShadow}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Metric card with gold top accent -->
    <Style x:Key="MetricCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="Effect" Value="{StaticResource PremiumShadow}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1,3,1,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{StaticResource HoverShadow}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========= SIDEBAR NAV BUTTON ========= -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="NavBorder"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="14,12"
                            Margin="6,2"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="NavIcon"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ContentPresenter x:Name="NavText"
                                              VerticalAlignment="Center"
                                              TextBlock.FontSize="13.5"
                                              TextBlock.FontWeight="Medium"
                                              TextBlock.FontFamily="{StaticResource PrimaryFont}"
                                              TextBlock.Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource AccentGoldLightBrush}" />
                            <Setter TargetName="NavIcon" Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter TargetName="NavText" Property="TextBlock.Foreground" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter TargetName="NavText" Property="TextBlock.FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= PREMIUM GOLD BUTTON ========= -->
    <Style x:Key="PremiumButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            CornerRadius="10"
                            Padding="22,11"
                            Effect="{StaticResource SubtleShadow}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#B8860B" Offset="0" />
                                <GradientStop Color="#D4AF37" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Effect" Value="{StaticResource HoverShadow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= OUTLINE BUTTON ========= -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BtnBorder"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="18,9"
                            BorderBrush="{DynamicResource AccentGoldBrush}"
                            BorderThickness="1.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource AccentGoldLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= FILTER CHIP BUTTON ========= -->
    <Style x:Key="FilterChip" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ChipBorder"
                            Background="#F1F5F9"
                            CornerRadius="18"
                            Padding="16,8"
                            BorderBrush="Transparent"
                            BorderThickness="1.5"
                            Effect="{StaticResource SubtleShadow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentGoldLightBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentGoldBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= PREMIUM TEXTBOX ========= -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="#F8F9FA" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Effect="{StaticResource SubtleShadow}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="2,0"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBrush}" />
                            <Setter Property="Background" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= SCROLLBAR STYLE ========= -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#C0C0C0" CornerRadius="3" Margin="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
