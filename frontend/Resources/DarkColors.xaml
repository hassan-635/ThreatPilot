<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Premium Luxury Color Palette -->
    <Color x:Key="AppBackground">#0F1115</Color>
    <Color x:Key="PanelBackground">#16191F</Color>
    
    <!-- White/Light gray text for dark mode -->
    <Color x:Key="TextPrimary">#F8F9FA</Color>
    <Color x:Key="TextSecondary">#A0AEC0</Color>
    <Color x:Key="TextMuted">#718096</Color>
    
    <!-- Subtle Gold/Champagne accent for luxury feel -->
    <Color x:Key="AccentGold">#D4AF37</Color>
    <Color x:Key="AccentGoldHover">#E5C158</Color>
    <Color x:Key="AccentGoldLight">#2D2615</Color>
    
    <!-- Soft Borders -->
    <Color x:Key="BorderLight">#2D3748</Color>
    <Color x:Key="BorderMedium">#4A5568</Color>

    <!-- Hover State -->
    <Color x:Key="HoverLight">#1A202C</Color>
    <Color x:Key="SidebarHover">#1E222A</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}" />
    <SolidColorBrush x:Key="AccentGoldHoverBrush" Color="{StaticResource AccentGoldHover}" />
    <SolidColorBrush x:Key="AccentGoldLightBrush" Color="{StaticResource AccentGoldLight}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}" />
    <SolidColorBrush x:Key="HoverLightBrush" Color="{StaticResource HoverLight}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHover}" />

    <!-- Shadows - softer for dark mode -->
    <DropShadowEffect x:Key="PremiumShadow" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.8" />
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.6" />
    <DropShadowEffect x:Key="HoverShadow" BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="1.0" />
    <DropShadowEffect x:Key="DeepShadow" BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="1.0" />

</ResourceDictionary>
