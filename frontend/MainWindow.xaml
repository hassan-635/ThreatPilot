<Window x:Class="ThreatPilot.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ThreatPilot.Frontend.ViewModels"
        xmlns:views="clr-namespace:ThreatPilot.Frontend.Views"
        Title="ThreatPilot — SOC Dashboard"
        Width="1250" Height="660"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource PrimaryFont}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- View-to-ViewModel DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IncidentViewModel}">
            <views:IncidentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo & Brand -->
                <StackPanel Grid.Row="0" Margin="24,28,24,28">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="10" Padding="8" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#C5A059" Offset="0" />
                                    <GradientStop Color="#D4AF37" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="🛡" FontSize="18" Foreground="White" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ThreatPilot" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="SOC Dashboard" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>



                <!-- Divider -->
                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderLightBrush}" Margin="20,0" />

                <!-- Navigation -->
                <StackPanel Grid.Row="2" Margin="12,16">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,0,0,10" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Dashboard" Tag="📊" GroupName="Nav"
                                 IsChecked="True"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Dashboard" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Threat Center" Tag="🔔" GroupName="Nav"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Alerts" />

                    <TextBlock Text="ANALYSIS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,24,0,10" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Incident Details" Tag="🔍" GroupName="Nav"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Incident" />
                                 
                    <TextBlock Text="SYSTEM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,24,0,10" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="⚙" GroupName="Nav"
                                 Command="{Binding NavigateToCommand}" CommandParameter="Settings" />
                </StackPanel>


            </Grid>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

    </Grid>
</Window>
