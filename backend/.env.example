# Copy this file to .env and fill with your secrets
# Local Postgres connection string (set your real password)
ConnectionStrings__DefaultConnection=Host=localhost;Database=threatpilot_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD

# JWT settings
Jwt__Key=your_super_secret_jwt_key_here_for_dotnet
Jwt__Issuer=ThreatPilotBackend
Jwt__Audience=ThreatPilotDesktop
